# Copia este archivo a .env para desarrollo local. NUNCA pongas aquí valores reales.
NODE_ENV=development

# API
HOST=0.0.0.0
PORT=4000
JSON_BODY_LIMIT=100kb
SHUTDOWN_TIMEOUT_MS=10000

# Logging: trace|debug|info|warn|error|fatal ; formato json|pretty
LOG_LEVEL=info
LOG_FORMAT=pretty

# PostgreSQL LOCAL (docker compose). Credenciales solo de desarrollo.
DATABASE_URL=postgres://blinka:blinka_local_dev@127.0.0.1:54329/blinka_dev
DATABASE_POOL_MAX=10
# disable     → sin TLS (solo PostgreSQL local)
# require     → TLS cifrado SIN verificar identidad del servidor (vulnerable a MITM; no usar en producción)
# verify-full → TLS + verificación de cadena y nombre de host (obligatorio en producción remota, p. ej. Supabase)
DATABASE_SSL=disable
# CA raíz en PEM para verify-full (p. ej. el certificado que publica Supabase). Vacío = CA del sistema.
DATABASE_SSL_CA_FILE=

# Conexión de APROVISIONAMIENTO (migrate/seed) con rol propietario/DDL.
# Vacío = usa DATABASE_URL (solo recomendable en local). En remoto, DATABASE_URL
# debe ser un rol de ejecución sin permisos DDL.
MIGRATION_DATABASE_URL=

# Base de datos de pruebas (aislada; el nombre debe terminar en _test)
TEST_DATABASE_URL=postgres://blinka:blinka_local_dev@127.0.0.1:54329/blinka_test

# Worker (Graphile Worker)
WORKER_CONCURRENCY=2

# Proxy inverso: false | número de saltos (Railway: 1) | lista IP/CIDR. Nunca "true".
TRUST_PROXY=false

# Sesiones y CSRF
# Orígenes del navegador que pueden enviar peticiones que modifican estado (coma-separados).
ALLOWED_ORIGINS=http://localhost:4000,http://localhost:5173
SESSION_TTL_HOURS=12
SESSION_IDLE_TIMEOUT_MINUTES=120
# true en producción (obligatorio). Los navegadores aceptan cookies Secure en http://localhost.
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=strict
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_PER_IP=20
LOGIN_RATE_LIMIT_PER_ACCOUNT=5

# Documentos privados: local (disco del servidor) | supabase (Supabase Storage, bucket PRIVADO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.storage
SUPABASE_URL=
# Clave de servicio de Supabase: SOLO servidor; nunca en el frontend ni en el repositorio.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=blinka-documents
DOCUMENT_MAX_BYTES=10485760
# Clave HMAC de huellas de cuentas bancarias (≥32 caracteres). Genera: openssl rand -base64 48
ACCOUNT_FINGERPRINT_SECRET=

# Tasas FX: fixture (SIMULADAS, solo local/demo) | frankfurter (v2, fuente explícita por moneda; verificado con GET reales 18-10-2026)
FX_PROVIDER=fixture
FX_FIXTURE_RATES=EUR:USD=1.0850,COP:USD=0.00024,USD:EUR=0.9200,USD:COP=4150
FRANKFURTER_URL=https://api.frankfurter.dev/v2
# Banco central por moneda (Frankfurter v2 /providers/{fuente}): COP → TRM del Banco de la República; resto → BCE
FX_FRANKFURTER_SOURCES=COP:BANREP,EUR:ECB,GBP:ECB,MXN:ECB,CAD:ECB,BRL:ECB,CHF:ECB,JPY:ECB
FX_MAX_AGE_HOURS=96
FX_REUSE_MINUTES=60
# En producción, FX_PROVIDER=fixture exige FX_ALLOW_SIMULATED=true explícito.
FX_ALLOW_SIMULATED=false
SUPPORTED_CURRENCIES=USD,EUR,COP,GBP,MXN,CAD,BRL,CHF,JPY

# IA: fake (MOCK, solo pruebas/demo local) | gemini (requiere GEMINI_API_KEY; SOLO servidor/worker)
AI_PROVIDER=fake
AI_ALLOW_FAKE=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
AI_MAX_CONCURRENCY=2
AI_TIMEOUT_MS=60000
AI_MAX_STEPS=4
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_TOTAL_TOKENS=60000
# Tarifas para el coste ESTIMADO (USD por millón de tokens): verificar con la tarifa vigente del proveedor.
AI_PRICE_INPUT_USD_PER_MTOK=0.30
AI_PRICE_OUTPUT_USD_PER_MTOK=2.50
ANALYSIS_MAX_PENDING_PER_COMPANY=10
ANALYSIS_RATE_LIMIT_PER_HOUR=60
ANALYSIS_STALE_RUN_MINUTES=30
# Recuperación automática de evaluaciones atascadas (worker, cron de Graphile)
RECOVERY_STALE_MINUTES=15
RECOVERY_MAX_ATTEMPTS=2
RECOVERY_CRON=*/5 * * * *

# Seed LOCAL (npm run db:seed). Nunca se ejecuta contra hosts remotos ni en producción.
# Genera la contraseña, p. ej.: openssl rand -base64 18
SEED_EVALUATOR_EMAIL=evaluador@demo.blinka.local
SEED_EVALUATOR_PASSWORD=
SEED_COMPANY_NAME="Blinka Demo Corp (ficticia)"
SEED_COMPANY_BASE_CURRENCY=USD
SEED_COMPANY_TIMEZONE=America/Bogota

# Guardia de bases remotas: migraciones y worker se niegan a operar sobre un host
# no local salvo que este valor sea exactamente "<host>/<database>" del destino.
# Déjalo vacío en desarrollo.
REMOTE_DB_CONFIRM=
