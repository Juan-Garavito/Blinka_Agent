{
  "name": "@blinka/backend",
  "version": "0.1.0",
  "private": true,
  "description": "Blinka PayGuard AI — backend (monolito modular: procesos api + worker)",
  "type": "module",
  "engines": {
    "node": ">=24.7.0"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "dev:worker": "tsx watch --env-file-if-exists=.env src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:worker": "node dist/worker.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=.env src/shared/db/migrate.ts",
    "db:migrate:test": "tsx --env-file-if-exists=.env src/shared/db/migrate-test.ts",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "db:seed": "tsx --env-file-if-exists=.env src/shared/db/seed.ts",
    "openapi:export": "tsx src/scripts/export-openapi.ts",
    "db:seed:demo": "tsx --env-file-if-exists=.env src/shared/db/seed.ts --demo",
    "demo:run": "tsx --env-file-if-exists=.env src/scripts/demo-run.ts",
    "test:external": "vitest run --config vitest.external.config.ts",
    "integration:preflight": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.supabase src/scripts/integration-preflight.ts",
    "gemini:models": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.gemini src/scripts/gemini-models.ts",
    "gemini:smoke": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.gemini src/scripts/gemini-smoke.ts",
    "start:gemini-worker": "node --env-file-if-exists=.env --env-file-if-exists=.env.gemini dist/worker.js",
    "storage:prepare": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.supabase src/scripts/prepare-private-storage.ts",
    "db:prepare:supabase": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.supabase src/scripts/prepare-supabase-runtime.ts",
    "db:migrate:supabase": "tsx --env-file-if-exists=.env --env-file=.env.supabase src/shared/db/migrate.ts",
    "start:supabase-api": "node --env-file-if-exists=.env --env-file=.env.supabase dist/server.js",
    "start:supabase-worker": "node --env-file-if-exists=.env --env-file=.env.supabase dist/worker.js",
    "start:gemini-api": "node --env-file-if-exists=.env --env-file-if-exists=.env.gemini dist/server.js",
    "supabase:secrets": "tsx src/scripts/supabase-secrets.ts",
    "db:seed:supabase": "tsx --env-file-if-exists=.env --env-file=.env.supabase src/shared/db/seed.ts",
    "db:seed:demo:supabase": "tsx --env-file-if-exists=.env --env-file=.env.supabase src/shared/db/seed.ts --demo",
    "db:extensions:supabase": "tsx --env-file-if-exists=.env --env-file=.env.supabase src/scripts/supabase-extensions.ts"
  },
  "dependencies": {
    "@langchain/core": "^1.2.18",
    "@langchain/langgraph": "^1.5.1",
    "cookie": "^2.0.1",
    "decimal.js": "^10.6.0",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "graphile-worker": "^0.18.0",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "unpdf": "^1.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^10.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vitest": "^5.0.5"
  }
}
