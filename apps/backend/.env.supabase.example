# Copiar a .env.supabase (ignorado). No reemplazar .env ni TEST_DATABASE_URL.
# Copiar datos exactos de Connect > Direct o Session pooler; NO :6543.
DATABASE_URL=
MIGRATION_DATABASE_URL=
DATABASE_SSL=verify-full
# Solo si el servidor requiere una CA adicional. Certificado público, no clave privada.
DATABASE_SSL_CA_FILE=
DATABASE_POOL_MAX=5
STORAGE_DRIVER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=blinka-documents
# Dejar VACÍO hasta recibir autorización expresa sobre proyecto/host/base.
REMOTE_DB_CONFIRM=
# Para npm CLI usar login o SUPABASE_ACCESS_TOKEN exportado en terminal.
# No se habilitan en este perfil migraciones, seeds ni arranque de procesos.

# Primera prueba de infraestructura: MOCK explícito, sin gasto de Gemini/FX.
AI_PROVIDER=fake
AI_ALLOW_FAKE=true
FX_PROVIDER=fixture
FX_ALLOW_SIMULATED=true

# API/worker en este equipo, no un despliegue de producción.
NODE_ENV=development
HOST=127.0.0.1
PORT=4003
ALLOWED_ORIGINS=http://localhost:4003
SESSION_COOKIE_SECURE=false
