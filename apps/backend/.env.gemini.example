# Copiar a .env.gemini (ignorado). Solo backend/worker; nunca VITE_*.
# El secreto real se introduce localmente, nunca en el chat ni en Git.
AI_PROVIDER=gemini
GEMINI_API_KEY=
# Verificado con smoke real 18-10-2026 (REAL_VERIFIED 3/3): requiere cuenta de pago (no Free tier).
# `npm run gemini:models` confirma disponibilidad exacta con models.get (sin generación).
GEMINI_MODEL=gemini-4-argon
AI_MAX_CONCURRENCY=1
AI_MAX_STEPS=3
# Argon con pensamiento tarda 5–31 s por llamada; 60 s cortó un especialista de 3 llamadas.
AI_TIMEOUT_MS=120000
AI_MAX_OUTPUT_TOKENS=4096
AI_MAX_TOTAL_TOKENS=20000
# USD/1M (salida incluye pensamiento). Introductorio hasta 30-11-2026; desde 01-12-2026: 4.00 / 20.00.
# Fuente: https://ai.google.dev/gemini-api/docs/latest-model — el smoke exige coincidencia con VERIFIED_PRICES.
AI_PRICE_INPUT_USD_PER_MTOK=2.00
AI_PRICE_OUTPUT_USD_PER_MTOK=10.00
# Alternativa verificada parcialmente antes: gemini-3.8-flash con 0.75 / 3.75.
